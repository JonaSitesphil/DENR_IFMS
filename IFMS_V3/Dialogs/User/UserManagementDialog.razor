@using Microsoft.AspNetCore.Components
@using MudBlazor
@inject ISnackbar Snackbar
@using IFMS_V3.Models.User.UserManagement
@using IFMS_V3.Dto.Update
@inject IFMS_V3.Services.User.UserService UserService
<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_editableUser.FirstName" Label="First Name" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_editableUser.LastName" Label="Last Name" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_editableUser.Email" Label="Email" Variant="Variant.Outlined" Class="mb-3" Disabled="true" />
        <MudTextField @bind-Value="_editableUser.Role" Label="Role" Variant="Variant.Outlined" />
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Save" Color="Color.Primary" Variant="Variant.Filled">
            Save
        </MudButton>
        <MudButton OnClick="Cancel" Color="Color.Secondary" Variant="Variant.Text">
            Cancel
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    [Parameter] public UserModel UserToEdit { get; set; }

    private UserModel _editableUser = new();

    protected override void OnInitialized()
    {
        _editableUser = new UserModel
        {
            Id = UserToEdit.Id,
            FirstName = UserToEdit.FirstName,
            LastName = UserToEdit.LastName,
            Email = UserToEdit.Email,
            Role = UserToEdit.Role
        };
    }

    private async Task Save()
    {
        try
        {
            var dto = new UpdateUserDto
            {
                FirstName = _editableUser.FirstName,
                LastName = _editableUser.LastName,
                Email = _editableUser.Email,
                RoleId = int.TryParse(_editableUser.Role, out var roleId) ? roleId : null
            };

            await UserService.UpdateUserAsync(UserToEdit.Id, dto);

            Snackbar.Add("User updated successfully.", Severity.Success);

            // ✅ return updated user to parent
            MudDialog.Close(DialogResult.Ok(_editableUser));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save changes: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
