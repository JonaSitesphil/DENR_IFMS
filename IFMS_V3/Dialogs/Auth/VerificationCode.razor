@using MudBlazor

<MudDialog>
    <MudDialogContent>
        <MudText Typo="Typo.h5" Class="mb-1">
            Code Verification
        </MudText>
        <MudText Typo="Typo.body2" Class="mb-4">
            A verification code has been sent to your email.
        </MudText>

        <div class="d-flex justify-center mb-2" style="gap: 8px;">
            @for (int i = 0; i < 6; i++)
            {
                <MudTextField T="string"
                              MaxLength="1"
                              Variant="Variant.Outlined"
                              Style="width: 50px; height: 50px; text-align: center; border-radius:8px;"
                              Margin="Margin.None" />
            }
        </div>

        <div class="d-flex justify-end mb-4">
            <MudText Link="true" Color="Color.Primary" Style="cursor:pointer;">
                Resend Code
            </MudText>
        </div>

        <div class="d-flex justify-center mt-2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       Style="width:200px; padding:10px 0; font-weight:600;">
                Verify
            </MudButton>
        </div>
    </MudDialogContent>
</MudDialog>
