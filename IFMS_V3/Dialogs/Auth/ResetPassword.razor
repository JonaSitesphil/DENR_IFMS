@page "/reset-password"
@using System.Net.Http.Json
@using IFMS_V3.Models.Auth
@using IFMS_V3.Models.Auth.Resetpassword
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudPaper Class="mx-auto mt-10" Style="max-width: 500px; padding: 20px;">
    <MudText Typo="Typo.h5" Align="Align.Center">Reset Your Password</MudText>

    <EditForm Model="@model" OnValidSubmit="OnResetPasswordAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

                <MudTextField Label="OTP Code"
                      @bind-Value="model.OtpCode"
                      Required="true"
                      MaxLength="10"
                      Margin="Margin.Dense" />

        <MudTextField Label="New Password"
                      @bind-Value="model.NewPassword"
                      InputType="InputType.Password"
                      Required="true"
                      Margin="Margin.Dense" />

        <MudTextField Label="Confirm Password"
                      @bind-Value="model.ConfirmNewPassword"
                      InputType="InputType.Password"
                      Required="true"
                      Margin="Margin.Dense" />

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Style="margin-top: 10px;">@errorMessage</MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <MudAlert Severity="Severity.Success" Style="margin-top: 10px;">@successMessage</MudAlert>
        }

        <MudDivider Class="my-4" />

        <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth="true" ButtonType="ButtonType.Submit">
            Reset Password
        </MudButton>
    </EditForm>
</MudPaper>

@code {
    private ResetPasswordModel model = new();
    private string errorMessage;
    private string successMessage;

    private async Task OnResetPasswordAsync()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        var response = await Http.PostAsJsonAsync("api/password/reset-password", model);

        if (response.IsSuccessStatusCode)
        {
            var apiResult = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();

            if (apiResult?.Status == "SUCCESS")
            {
                successMessage = "Password reset successful.";
                Snackbar.Add(successMessage, Severity.Success);

                await Task.Delay(1000);
                Navigation.NavigateTo("/", forceLoad: true);
            }
            else
            {
                errorMessage = apiResult?.Message ?? "Failed to reset password.";
            }
        }
        else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            var errorJson = await response.Content.ReadFromJsonAsync<ValidationErrorResponse>();

            if (errorJson?.Errors != null)
            {
                var allMessages = errorJson.Errors.SelectMany(e => e.Value).ToArray();
                errorMessage = string.Join(" ", allMessages);
            }
            else
            {
                errorMessage = "Validation failed. Please check your input.";
            }
        }
        else
        {
            errorMessage = "Server error. Please try again later.";
        }
    }

    public class ValidationErrorResponse
    {
        public Dictionary<string, string[]> Errors { get; set; }
    }
}
