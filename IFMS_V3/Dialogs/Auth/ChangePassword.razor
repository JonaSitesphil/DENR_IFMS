@page "/change-password"
@using IFMS_V3.Services
@using IFMS_V3.Models.Auth.ChangePassword
@using MudBlazor
@inject IFMS_V3.Services.Auth.AuthService AuthService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@* @layout ChangePasswordLayout *@

<MudPaper Class="p-6 mx-auto mt-10" Style="max-width: 500px;" Elevation="3">
    <MudText Typo="Typo.h5" Class="mb-1">Change Password</MudText>

    <MudForm @ref="mudForm">
        <MudTextField T="string"
                      Label="Current Password"
                      InputType="InputType.Password"
                      @bind-Value="changePassword.CurrentPassword"
                      Required="true"
                      Immediate="true"
                      Validation="@( (string v) => ValidateCurrentPassword(v) )"
                      Class="mb-3" />

        <MudTextField T="string"
                      Label="New Password"
                      InputType="InputType.Password"
                      @bind-Value="changePassword.NewPassword"
                      Required="true"
                      Immediate="true"
                      Validation="@( (string v) => ValidatePassword(v) )"
                      Class="mb-3" />

        <MudTextField T="string"
                      Label="Confirm New Password"
                      InputType="InputType.Password"
                      @bind-Value="changePassword.ConfirmNewPassword"
                      Required="true"
                      Immediate="true"
                      Validation="@( (string v) => ValidateConfirmPassword(v) )"
                      Class="mb-3" />

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Style="margin-top: 10px;">@errorMessage</MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <MudAlert Severity="Severity.Success" Style="margin-top: 10px;">@successMessage</MudAlert>
        }

        <div class="d-flex justify-center mt-4">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="SubmitForm"
                       Disabled="@isSubmitting"
                       Style="width: 200px; padding: 10px 0; font-weight:600;">
                @if (isSubmitting)
                {
                    <MudProgressCircular Indeterminate Color="Color.Inherit" Size="Size.Small" Class="mr-2" />
                    <span>Changing</span>
                }
                else
                {
                    <span>Reset Password</span>
                }
            </MudButton>
        </div>
    </MudForm>
</MudPaper>

@code {
    private MudForm mudForm;
    private ChangePasswordModel changePassword = new();
    private bool isSubmitting = false;

    private string errorMessage;
    private string successMessage;

    private string ValidateCurrentPassword(string currentPassword)
    {
        if (string.IsNullOrWhiteSpace(currentPassword))
            return "Current password is required.";
        return null;
    }

    private string ValidatePassword(string password)
    {
        if (string.IsNullOrWhiteSpace(password))
            return "New password is required.";

        if (password.Length < 8)
            return "Password must be at least 8 characters.";

        if (!System.Text.RegularExpressions.Regex.IsMatch(password, @"[A-Z]"))
        {
            Snackbar.Add("Password must contain at least one uppercase letter.", Severity.Error);
            return "Password must contain at least one uppercase letter.";
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(password, @"[a-z]"))
        {
            Snackbar.Add("Password must contain at least one lowercase letter.", Severity.Error);
            return "Password must contain at least one lowercase letter.";
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(password, @"\d"))
        {
            Snackbar.Add("Password must contain at least one number.", Severity.Error);
            return "Password must contain at least one number.";
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(password, @"[\W_]"))
        {
            Snackbar.Add("Password must contain at least one special character.", Severity.Error);
            return "Password must contain at least one special character.";
        }

        return null;
    }

    private string ValidateConfirmPassword(string confirm)
    {
        if (string.IsNullOrWhiteSpace(confirm))
            return "Please re-enter the new password.";

        if (confirm != changePassword.NewPassword)
            return "Passwords do not match.";

        return null;
    }

    private async Task SubmitForm()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        await mudForm.Validate();

        if (!mudForm.IsValid)
        {
            errorMessage = "Please fix the form errors.";
            return;
        }

        isSubmitting = true;

        var response = await AuthService.ChangePasswordAsync(changePassword);

        if (response.Status == "SUCCESS")
        {
            successMessage = "Password changed successfully!";
            Snackbar.Add(successMessage, Severity.Success);

            await Task.Delay(1000);
            NavigationManager.NavigateTo("/", true);
        }
        else
        {
            errorMessage = response.Message ?? "Failed to change password.";
            Snackbar.Add(errorMessage, Severity.Error);
        }

        isSubmitting = false;
    }
}
