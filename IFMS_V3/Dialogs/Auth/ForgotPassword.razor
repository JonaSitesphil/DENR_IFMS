@page "/forgot-password"
@inject HttpClient Http
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@using IFMS_V3.Models.Auth
@layout EmptyLayout
@attribute [AllowAnonymous]

<MudPaper Style="padding: 20px; max-width: 500px; margin: auto; margin-top: 200px;">

    <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-1">Forgot Password</MudText>
    <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-5">
        Enter your registered email to receive a verification code.
    </MudText>

    <MudTextField Label="Enter your Email"
                  @bind-Value="email"
                  Required="true"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense" />

    @if (!string.IsNullOrWhiteSpace(responseMessage))
    {
        <MudAlert Severity="Severity.Success">@responseMessage</MudAlert>
    }

    <!-- Bottom buttons aligned left and right -->
    <div style="margin-top: 20px; display: flex; justify-content: space-between;">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   OnClick="@Cancel"
                   Disabled="isLoading">
            Cancel
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SendOtp"
                   Disabled="isLoading"
                   Loading="@isLoading"
                   LoadingIndicatorColor="Color.Inherit">
            Send OTP
        </MudButton>
    </div>

</MudPaper>

@code {
    private string email;
    private string responseMessage;
    private bool isLoading = false;

    private async Task SendOtp()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            Snackbar.Add("Email is required.", Severity.Error);
            return;
        }

        isLoading = true;

        try
        {
            var result = await Http.PostAsJsonAsync("api/password/forgot-password", new { email });
            var response = await result.Content.ReadFromJsonAsync<ApiResponse<object>>();

            responseMessage = response?.Message;

            if (response?.Status == "SUCCESS")
            {
                Snackbar.Add("OTP sent successfully!", Severity.Success);

                // Show "Check your email" confirmation dialog
                var dialogOptions = new DialogOptions()
                {
                    CloseOnEscapeKey = true,
                    MaxWidth = MaxWidth.ExtraSmall,
                    FullWidth = true
                };

                var dialog = DialogService.Show<CheckYourEmail>("Check Your Email", dialogOptions);
                var dialogResult = await dialog.Result;

                if (!dialogResult.Canceled)
                {
                    Navigation.NavigateTo("/", forceLoad: true); // Redirect to login after closing modal
                }
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Failed to send OTP.", Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("An error occurred while sending OTP.", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/");
    }
}
