@page "/processor-budgetmanagement"
@* @layout SharedLayout *@
@using IFMS_V3.Dialogs.Norsa
@inject IDialogService DialogService
@using IFMS_V3.Models.Ors.ProcessorModel
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IFMS_V3.Services.Ors.OrsService OrsService



<MudContainer Class="mt-4 px-8" MaxWidth="MaxWidth.False">
    <MudContainer Class="px-0" MaxWidth="MaxWidth.False">
        <MudPaper>f
            <MudGrid Class="mb-4">
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="_searchText"
                                  Placeholder="Search"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true"
                                  Class="w-100"
                                  Style="border-radius: 8px;" />
                </MudItem>
                <MudItem xs="6" sm="2" Class="d-flex justify-end">
                    <MudSelect T="string"
                               Value="@_selectedFilter"
                               ValueChanged="OnOptionChanged"
                               Class="w-100"
                               Color="Color.Primary"
                               Variant="Variant.Outlined"
                               Dense="true">
                        <MudSelectItem Value="@("Default")">Default</MudSelectItem>
                        <MudSelectItem Value="@("Ors")">ORS</MudSelectItem>
                        <MudSelectItem Value="@("Burs")">BURS</MudSelectItem>
                        <MudSelectItem Value="@("Norsa")">NORSA</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="2" Class="d-flex justify-end">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               OnClick="RefreshTable"
                               Class="w-100">
                        Refresh
                    </MudButton>
                </MudItem>
            </MudGrid>


            <MudTable Items="FilteredRecords" Hover="true" Striped="true" Bordered="true">
                <HeaderContent>
                    <MudTh Style="text-align:center; padding: 1rem 8px; background-color: midnightblue; color: white;">Payee</MudTh>
                    <MudTh Style="text-align:center; padding: 1rem 8px; background-color: midnightblue; color: white;">Transaction ID</MudTh>
                    <MudTh Style="text-align:center; padding: 1rem 8px; background-color: midnightblue; color: white;">Amount</MudTh>
                    <MudTh Style="text-align:center; padding: 1rem 8px; background-color: midnightblue; color: white;">Type</MudTh>
                    <MudTh Style="text-align:center; padding: 1rem 8px; background-color: midnightblue; color: white;">Status</MudTh>
                    <MudTh Style="text-align:center; padding: 1rem 8px; background-color: midnightblue; color: white;">Actions</MudTh>

                </HeaderContent>
                <RowTemplate Context="record">
                    <MudTd DataLabel="Payee">@record.Payee</MudTd>
                    <MudTd DataLabel="ID">@record.Id</MudTd>
                    <MudTd DataLabel="Amount">@record.Amount</MudTd>
                    <MudTd DataLabel="Type">@record.Type</MudTd>
                    <MudTd DataLabel="Status">@record.Status</MudTd>
                    <MudTd>

                        <MudButton>
                            Review
                        </MudButton>
                        <MudButton>
                            Reject
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudContainer>
</MudContainer>




@code {
    private bool hover1 = true;
    private bool striped1 = true;
    private bool bordered1 = true;

    private string _selectedFilter = "All";
    private string _searchText = string.Empty;
    public double[] data = { 5, 2 };
    public string[] labels = { "Complete", "Incomplete" };
    
    private List<ProcessorModel.ProcessorDashboardModel> records = new();
    private List<ProcessorModel.ProcessorDashboardModel> Bursrecords = new();

    private IEnumerable<ProcessorModel.ProcessorDashboardModel> FilteredRecords =>
       records.Where(r =>
           (_selectedFilter == "All" ||
            (r.Type?.Equals(_selectedFilter, StringComparison.OrdinalIgnoreCase) ?? false))
           &&
           (string.IsNullOrWhiteSpace(_searchText) ||
            r.Payee.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
       );

    private void SetFilter(string filter)
    {
        _selectedFilter = filter;
    }

    // private async Task OnOptionChanged(string value)
    // {
    //     _selectedFilter = value;
    //     await InvokeAsync(StateHasChanged);
    // }

    private void GoToORSPage()
    {
        NavigationManager.NavigateTo("/ors-form");
    }


    private void GoToBURSPage()
    {
        NavigationManager.NavigateTo("/burs-form");
    }

    private async Task ShowNORSADialog()
    {
        var dialog = await DialogService.ShowAsync<Norsa>("NORSA");
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            // handle
        }
    }
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/", true);
            return;
        }

        try
        {
            records = await OrsService.GetAllProcessorDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load dashboard data. Error: {ex.Message}", Severity.Error);
            records = new List<ProcessorModel.ProcessorDashboardModel>();
        }
    }


    private async Task OnOptionChanged(string value)
    {
        _selectedFilter = value;
        await InvokeAsync(StateHasChanged);
    }
    private void PreviewRow(string row)
    {
        Console.WriteLine($"Preview clicked for row: {row}");
        // Later: open a dialog with details
    }
    private void RefreshTable()
    {
        _searchText = "";
        _selectedFilter = "Default";
        StateHasChanged(); // re-render UI
    }


}


