    // {
    //     try
    //     {
    //         isLoading = true;
    //         StateHasChanged();

    //         var response = await SignatoryService.GetSignatoriesAsync(currentPage, pageSize);

    //         if (response != null && response.Status == "SUCCESS" && response.Data != null)
    //         {
    //             signatoryList = response.Data.SignatoryList ?? new List<SignatoriesModels>();
    //             totalRecords = response.Data.TotalRecords;
    //         }
    //         else
    //         {
    //             signatoryList = new List<SignatoriesModels>();
    //             totalRecords = 0;
    //             Snackbar.Add("Failed to fetch signatories.", Severity.Error);
    //         }
    //     }
    //     finally
    //     {
    //         isLoading = false;
    //         StateHasChanged();
    //     }
    // }
    private async Task LoadDataAsync()
    {
        try
        {
            isLoading = true;
            Console.WriteLine("🔄 Fetching signatories...");
            StateHasChanged();

            var response = await SignatoryService.GetSignatoriesAsync(currentPage, pageSize);

            if (response != null && response.Status == "SUCCESS" && response.Data != null)
            {
                Console.WriteLine($"✅ Got {response.Data.SignatoryList?.Count} records");
                signatoryList = response.Data.SignatoryList ?? new List<SignatoriesModels>();
                totalRecords = response.Data.TotalRecords;
            }
            else
            {
                Console.WriteLine("⚠️ Failed response or null data");
                signatoryList = new List<SignatoriesModels>();
                totalRecords = 0;
                Snackbar.Add("Failed to fetch signatories.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ LoadDataAsync failed: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
    private async Task EditSignatory(SignatoriesModels sig)
    {
        var parameters = new DialogParameters { ["SignatoryToEdit"] = sig };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<SignatoryDialog>("Edit Signatory", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is SignatoriesModels updatedSignatory)
        {
            var index = signatoryList.FindIndex(s => s.Id == updatedSignatory.Id);
            if (index != -1) signatoryList[index] = updatedSignatory;
            StateHasChanged();
        }
    }

}
