@page "/admin-dashboard"
@layout MainLayout
@inject ISnackbar Snackbar
@* @using IFMS.Dialogs *@
@using MudBlazor
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthProvider
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@using IFMS_V3.Models.Ors.AdminDashboardModel
@inject IFMS_V3.Services.Ors.OrsService OrsService

<AuthorizeView>
    <Authorized>
        <MudContainer Class="mt-2 px-8" Style="height: 250px; display: flex;" MaxWidth="MaxWidth.False">
            <div style="display: flex; width: 100%; height: 100%; gap: 20px; align-items: flex-end;">
                <MudPaper Elevation="3" Height="100%" Style="flex: 2;" Square="true" Class="white d-flex flex-column align-center rounded">
                    <a href="/Status"
                       class="mud-typography mud-typography-body1"
                       style="display: block; width: 100%; padding: 1rem 2rem; text-decoration: none; color: black; text-align: center;"
                       onmouseover="this.style.backgroundColor='#f6f6f6'; this.style.color='darkblue';"
                       onmouseout="this.style.backgroundColor='transparent'; this.style.color='black';">
                        Announcements
                    </a>
                </MudPaper>

                <!-- Donut Chart -->
                <MudPaper Elevation="3" Height="100%" Style="flex: 1;" Square="true" Class="white d-flex flex-column align-center rounded">
                    <a href="/Status"
                       class="mud-typography mud-typography-body1"
                       style="display: block; width: 100%; padding: 1rem 2rem; text-decoration: none; color: black; text-align: center;"
                       onmouseover="this.style.backgroundColor='#f6f6f6'; this.style.color='darkblue';"
                       onmouseout="this.style.backgroundColor='transparent'; this.style.color='black';">
                        Application Status Summary
                    </a>

                    <MudChart ChartType="ChartType.Donut"
                              Width="55%" Height="55%" InputData="@data" InputLabels="@labels">
                        <CustomGraphics>
                            <text x="50%" y="45%" dominant-baseline="middle" text-anchor="middle" fill="black" font-size="30">Total</text>
                            <text x="50%" y="65%" dominant-baseline="middle" text-anchor="middle" fill="black" font-size="48">@data.Sum()</text>
                        </CustomGraphics>
                    </MudChart>
                </MudPaper>
            </div>
        </MudContainer>

        <!-- FILTER + TABLE -->
        <MudContainer Class="px-0" MaxWidth="MaxWidth.False">
            <MudContainer Class="mt-4 px-8" MaxWidth="MaxWidth.False">
                <MudPaper>
                    <MudGrid Class="mb-4" AlignItems="AlignItems.Center">
                        <!-- Search + Filter + Refresh in One Row -->
                        <MudItem xs="12" sm="10" Class="d-flex align-center gap-2">

                            <MudTextField @bind-Value="_searchText"
                                          Placeholder="Search"
                                          Variant="Variant.Outlined"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          Immediate="true"
                                          Class="flex-grow-1"
                                          Style="border-radius: 8px;" />
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                       OnClick="RefreshTable">
                                Refresh
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                    <MudTabs>
                        <MudTabPanel Text="ORS">
                            @if (records == null)
                            {
                                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                            }
                            else
                            {
                                <MudTable Items="FilteredRecords" Hover="true" Striped="true" Bordered="true">
                                    <HeaderContent>
                                        <MudTh Style="text-align:center; padding: 1rem 8px; background-color: midnightblue; color: white;">Payee</MudTh>
                                        <MudTh Style="text-align:center; padding: 1rem 8px; background-color: midnightblue; color: white;">Transaction ID</MudTh>
                                        <MudTh Style="text-align:center; padding: 1rem 8px; background-color: midnightblue; color: white;">Amount</MudTh>
                                        <MudTh Style="text-align:center; padding: 1rem 8px; background-color: midnightblue; color: white;">Type</MudTh>
                                        <MudTh Style="text-align:center; padding: 1rem 8px; background-color: midnightblue; color: white;">Status</MudTh>
                                    </HeaderContent>
                                    <RowTemplate Context="record">
                                        <MudTd>@record.payee</MudTd>
                                        <MudTd>@record.id</MudTd>
                                        <MudTd>@record.amount</MudTd>
                                        <MudTd>@record.type</MudTd>
                                        <MudTd>@record.status</MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        </MudTabPanel>

                        <MudTabPanel Text="BURS">
                            @if (records == null)
                            {
                                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                            }
                            else
                            {
                                <MudTable Items="bursRecords" Hover="true" Striped="true" Bordered="true">
                                    <HeaderContent>
                                        <MudTh Style="text-align:center; padding: 1rem 8px; background-color: midnightblue; color: white;">Payee</MudTh>
                                        <MudTh Style="text-align:center; padding: 1rem 8px; background-color: midnightblue; color: white;">Transaction ID</MudTh>
                                        <MudTh Style="text-align:center; padding: 1rem 8px; background-color: midnightblue; color: white;">Amount</MudTh>
                                        <MudTh Style="text-align:center; padding: 1rem 8px; background-color: midnightblue; color: white;">Type</MudTh>
                                        <MudTh Style="text-align:center; padding: 1rem 8px; background-color: midnightblue; color: white;">Status</MudTh>
                                    </HeaderContent>
                                    <RowTemplate Context="record">
                                        <MudTd>@record.payee</MudTd>
                                        <MudTd>@record.id</MudTd>
                                        <MudTd>@record.amount</MudTd>
                                        <MudTd>@record.type</MudTd>
                                        <MudTd>@record.status</MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        </MudTabPanel>
                    </MudTabs>

                    @* <MudTabPanel Text="NORSA">
                        @if (records == null)
                        {
                            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                        }
                        else
                        {
                            <MudTable Items="records" Hover="true" Striped="true" Bordered="true">
                                <HeaderContent>
                                    <MudTh Style="text-align:center; padding: 1rem 8px; background-color: midnightblue; color: white;">Payee</MudTh>
                                    <MudTh Style="text-align:center; padding: 1rem 8px; background-color: midnightblue; color: white;">Transaction ID</MudTh>
                                    <MudTh Style="text-align:center; padding: 1rem 8px; background-color: midnightblue; color: white;">Amount</MudTh>
                                    <MudTh Style="text-align:center; padding: 1rem 8px; background-color: midnightblue; color: white;">Type</MudTh>
                                    <MudTh Style="text-align:center; padding: 1rem 8px; background-color: midnightblue; color: white;">Status</MudTh>
                                </HeaderContent>
                                <RowTemplate Context="record">
                                    <MudTd DataLabel="Payee">@record.payee</MudTd>
                                    <MudTd DataLabel="ID">@record.id</MudTd>
                                    <MudTd DataLabel="Amount">@record.amount</MudTd>
                                    <MudTd DataLabel="Type">@record.type</MudTd>
                                    <MudTd DataLabel="Status">@record.status</MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudTabPanel> *@

                </MudPaper>
            </MudContainer>
        </MudContainer>
    </Authorized>

    <NotAuthorized>
        <MudContainer Class="mt-6 d-flex justify-center">
            <MudAlert Severity="Severity.Error">
                You are not authorized to view this page. Please <a href="/">log in</a>.
            </MudAlert>
        </MudContainer>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string _selectedFilter = "Default";
    private string _searchText = "";

    public double[] data = { 5, 2 };
    public string[] labels = { "Complete", "Incomplete" };

    private List<AdmindashboardModel> records = new();
    private List<AdmindashboardModel> bursRecords = new();

    private IEnumerable<AdmindashboardModel> FilteredRecords =>
        records.Where(r =>
            (_selectedFilter == "Default" ||
             (r.type?.Equals(_selectedFilter, StringComparison.OrdinalIgnoreCase) ?? false))
            &&
            (string.IsNullOrWhiteSpace(_searchText) ||
             r.payee.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
        );

    private IEnumerable<AdmindashboardModel> Records =>
        records.Where(r =>
            (_selectedFilter == "Default" ||
             (r.type?.Equals(_selectedFilter, StringComparison.OrdinalIgnoreCase) ?? false))
            &&
            (string.IsNullOrWhiteSpace(_searchText) ||
             r.payee.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
        );


    private void RefreshTable()
    {
        _searchText = string.Empty;
        _selectedFilter = "Default";
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
{
    var authState = await AuthProvider.GetAuthenticationStateAsync();
    var user = authState.User;

    if (!user.Identity.IsAuthenticated)
    {
        Navigation.NavigateTo("/", true);
        return;
    }

    try
    {
        // ✅ Fetch ORS records
            var orsResponse = await OrsService.GetAdminOrsDashboardDataAsync();
            records = orsResponse?.Data?.Records ?? new List<AdmindashboardModel>();

            // BURS
            var bursResponse = await OrsService.GetAdminBursDashboardDataAsync();
            bursRecords = bursResponse?.Data?.Records ?? new List<AdmindashboardModel>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load dashboard data. {ex.Message}", Severity.Error);
            records = new List<AdmindashboardModel>();
            bursRecords = new List<AdmindashboardModel>();
        }

}
}
